# Скопируй в /opt/hack/.env и заполни. Без комментариев в строках.
ADMIN_SECRET=ЗАМЕНИ_длинный_случайный
WORKER_SECRET=ЗАМЕНИ_другой_длинный_случайный
NVIDIA_API_KEY=nvapi-ЗАМЕНИ
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b
LLM_TIMEOUT=90
LLM_MAX_TOKENS=16000
LLM_HEDGE_SECONDS=20
GENERATE_TIMEOUT=240
BUILD_TIMEOUT=300
RATE_LIMIT_SECONDS=60
DB_FILE=data/queue.db
OSM_CACHE=data/osm_cache
UNMATCHED_FILE=data/unmatched.txt
