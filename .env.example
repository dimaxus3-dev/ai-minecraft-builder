# --- строитель (ноутбук) ---
MC_HTTP=http://localhost:9000   # HTTP-интерфейс мода GDMC
GROUND_Y=-60                    # уровень, с которого строим (плоский мир: -60)
BUILD_DELAY=0.12                # пауза между слоями, сек

# --- бэкенд (VDS), пригодится с Фазы 2 ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ADMIN_SECRET=
# PUBLIC_URL=https://1-2-3-4.sslip.io
# VDS_WS_URL=wss://1-2-3-4.sslip.io/ws/worker

# --- LLM (NVIDIA NIM, OpenAI-совместимый endpoint) ---
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=90
# Модели-«рассуждатели» тратят тысячи токенов на размышления;
# с маленьким лимитом JSON обрывается на середине.
LLM_MAX_TOKENS=16000
NVIDIA_API_KEY=nvapi-...

# --- очередь и сервер (Фаза 3) ---
ADMIN_SECRET=поставь_свой_секрет
RATE_LIMIT_SECONDS=60       # один запрос в минуту с одного IP (0 — выключить)
BUILD_DURATION=10           # за сколько секунд растёт одна постройка
GENERATE_TIMEOUT=240        # предел ожидания LLM
BUILD_TIMEOUT=300           # если воркер молчит дольше — запрос в failed
DB_FILE=data/queue.db
PLOTS_FILE=data/plots.json
CITY_X=0                    # центр города в мире
CITY_Z=0
