# --- строитель (ноутбук) ---
MC_HTTP=http://localhost:9000   # HTTP-интерфейс мода GDMC
GROUND_Y=-60                    # уровень, с которого строим (плоский мир: -60)
BUILD_DELAY=0.12                # пауза между слоями, сек

# --- бэкенд (VDS), пригодится с Фазы 2 ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ADMIN_SECRET=
# PUBLIC_URL=https://1-2-3-4.sslip.io
# VDS_WS_URL=wss://1-2-3-4.sslip.io/ws/worker

# --- LLM (NVIDIA NIM, OpenAI-совместимый endpoint) ---
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b,nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT=55
# Модели-«рассуждатели» тратят тысячи токенов на размышления;
# с маленьким лимитом JSON обрывается на середине.
LLM_MAX_TOKENS=16000
LLM_HEDGE_SECONDS=8      # следующая модель стартует через столько секунд, если ответа нет
NVIDIA_API_KEY=nvapi-...

# --- Gemini (необязательно): вторым провайдером в ту же гонку ---
# Ключ из Google AI Studio; в проекте должен быть включён Gemini API.
# GEMINI_API_KEY=...
# Модель пишется как google/<имя>, например google/gemini-3.8-flash

# --- очередь и сервер (Фаза 3) ---
ADMIN_SECRET=поставь_свой_секрет
RATE_LIMIT_SECONDS=60       # один запрос в минуту с одного IP (0 — выключить)
BUILD_DURATION=10           # за сколько секунд растёт одна постройка
GENERATE_TIMEOUT=120        # предел ожидания решателя
BUILD_TIMEOUT=300           # если воркер молчит дольше — запрос в failed
DB_FILE=data/queue.db
PLOTS_FILE=data/plots.json
CITY_X=0                    # центр города в мире
CITY_Z=0

# --- показ (Фаза 5) ---
CAMERA=on                   # облёт камерой и титры; off — выключить
# PLAYER_NAME=              # ник игрока-камеры; пусто — первый игрок в мире
CAMERA_IDLE=on                # после стройки камера кружит по построенным зданиям; off — вернуть управление игроку

CAMERA_SPEED=8                # максимальная скорость облёта, градусов в секунду
CAMERA_TRANSITION=3           # плавный перелёт между зданиями, секунд
# WORKER_SECRET=              # одинаковый секрет на VDS и ноутбуке

# --- скорость решателя ---
RESEARCH_WAIT=4             # сколько ждём справку Википедии, сек
OSM_HEAD_START=5            # фора карте: успела — модель не зовём вовсе
OSM_WAIT=12                 # предел ожидания карты, сек
